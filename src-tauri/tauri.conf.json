{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cultera OS",
  "version": "0.0.1",
  "identifier": "de.cultera.focus",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cultera OS",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/Icon.ico",
      "icons/icon.icns"
    ],
    "publisher": "Cultera",
    "copyright": "© 2026 Cultera",
    "category": "Business",
    "shortDescription": "Kunden- und Projektverwaltung für Selbstständige",
    "longDescription": "Cultera OS ist eine Desktop-App für Selbstständige und kleine Agenturen zur professionellen Kunden- und Projektverwaltung.",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["German"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/cynhendrik/focus/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4QjVBRTBCMzlDNzlCNwpSV1MzZVp5ejRGcUxBeVRaOHFsS3NERjgyUnkzcGV0OEJJdGFRajFQVkFWU2RJejFLWTRLTFoydAo="
    }
  }
}
